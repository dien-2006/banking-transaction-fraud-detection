# Local configuration template. Generate unique secrets before starting.
# ============================================================
# D4 BANK - LOCAL DEMO ENVIRONMENT
# ============================================================
TZ=Asia/Ho_Chi_Minh
SOURCE_TIMEZONE=Asia/Ho_Chi_Minh

# ============================================================
# IMAGE VERSIONS
# ============================================================
POSTGRES_VERSION=17
KAFKA_VERSION=7.9.0
AIRFLOW_VERSION=2.10.5
KAFKA_UI_VERSION=v0.7.2
MINIO_VERSION=RELEASE.2025-09-07T16-13-09Z
MINIO_MC_VERSION=RELEASE.2025-08-13T08-35-41Z
SPARK_VERSION=3.5.5
HIVE_VERSION=4.0.0
POSTGRES_JDBC_VERSION=42.7.5
HADOOP_AWS_VERSION=3.3.4
AWS_JAVA_SDK_BUNDLE_VERSION=1.12.262
REDIS_VERSION=7.4-alpine
TRINO_VERSION=483

# ============================================================
# BANK POSTGRESQL
# ============================================================
POSTGRES_DB=D4Bank
POSTGRES_USER=bank_admin
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_HOST_DOCKER=postgres-bank

# ============================================================
# BANKING API / WEB
# ============================================================
BANKING_API_PORT=8000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
JWT_SECRET=
TRINO_URL=http://trino:8080
TRINO_USER=d4-bank-api

# ============================================================
# TRANSFER OTP / EMAIL
# Leave Brevo values empty until a verified sender is available.
# ============================================================
REDIS_URL=redis://redis:6379
OTP_HASH_SECRET=
BREVO_API_KEY=
OTP_SENDER_EMAIL=
OTP_SENDER_NAME=D4 Bank
NOTIFICATION_BATCH_SIZE=20
NOTIFICATION_POLL_INTERVAL_MS=3000

# ============================================================
# KAFKA
# ============================================================
KAFKA_CLUSTER_ID=G8Azc-2nQXWlh6VI0dsTLQ
KAFKA1_PORT=9092
KAFKA2_PORT=9093
KAFKA3_PORT=9094
KAFKA_UI_PORT=8080
KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9093,localhost:9094
KAFKA_BOOTSTRAP_SERVERS_DOCKER=kafka1:29092,kafka2:29092,kafka3:29092
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=3
KAFKA_RETENTION_MS=604800000
KAFKA_TRANSACTION_TOPIC=banking.transaction-events.v1
KAFKA_ACCOUNT_EVENTS_TOPIC=banking.account-events.v1
KAFKA_LOGIN_EVENTS_TOPIC=banking.login-events.v1
KAFKA_LOAN_EVENTS_TOPIC=banking.loan-events.v1
KAFKA_CONSUMER_GROUP=bronze-transaction-writer-v1
KAFKA_ACCOUNT_CONSUMER_GROUP=bronze-account-writer-v1
KAFKA_LOGIN_CONSUMER_GROUP=bronze-login-writer-v1
KAFKA_LOAN_CONSUMER_GROUP=bronze-loan-writer-v1

# Keep Kafka events in durable Bronze; PostgreSQL Batch remains Silver truth.
ENABLE_REALTIME_SILVER_MERGE=true

# ============================================================
# MINIO
# ============================================================
MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT_HOST=http://localhost:9000
MINIO_ENDPOINT_DOCKER=http://minio:9000
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_QUARANTINE=quarantine
MINIO_BUCKET_GOLD=gold
MINIO_BUCKET_ML=ml-models
MINIO_BUCKET_CONTROL=pipeline-control

# ============================================================
# SPARK
# ============================================================
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8082
SPARK_WORKER_UI_PORT=8083
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g

# ============================================================
# AIRFLOW
# ============================================================
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_ADMIN_EMAIL=
AIRFLOW_PORT=8081
AIRFLOW_DAGS_PAUSED_AT_CREATION=false

# ============================================================
# ANALYTICS / MACHINE LEARNING
# ============================================================
MODEL_DB_NAME=fraud_detection_v1
TRINO_PORT=8084
MODEL_DB_MAPPING={}

# Online inference uses the existing nineteen-feature fitted joblib pipeline.
# Docker Compose supplies container paths and the pinned Python environment.
JOBLIB_MODEL_PATH=models/fraud_detection_model.joblib
JOBLIB_METADATA_PATH=models/model_metadata.json
BANKING_DB_USER=
BANKING_DB_PASSWORD=
OUTBOX_DB_USER=
OUTBOX_DB_PASSWORD=
NOTIFICATION_DB_USER=
NOTIFICATION_DB_PASSWORD=
ETL_DB_USER=
ETL_DB_PASSWORD=
