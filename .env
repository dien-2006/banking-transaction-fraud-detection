# ============================================================
# GLOBAL
# ============================================================
TZ=Asia/Ho_Chi_Minh

# ============================================================
# IMAGE VERSIONS
# ============================================================
POSTGRES_VERSION=17
KAFKA_VERSION=7.9.0
AIRFLOW_VERSION=2.10.5
KAFKA_UI_VERSION=latest
MINIO_VERSION=latest

# ============================================================
# BANK POSTGRESQL
# ============================================================
POSTGRES_DB=D4Bank
POSTGRES_USER=admin
POSTGRES_PASSWORD=d4bank
POSTGRES_PORT=5432

# Host:
# postgresql://bank_admin:change_me_bank@localhost:5432/bank_fraud
# Docker network:
# postgresql://bank_admin:change_me_bank@postgres-bank:5432/bank_fraud

# ============================================================
# KAFKA
# ============================================================
# Generate once:
# docker run --rm confluentinc/cp-kafka:7.9.0 kafka-storage random-uuid
KAFKA_CLUSTER_ID=G8Azc-2nQXWlh6VI0dsTLQ

KAFKA1_PORT=9092
KAFKA2_PORT=9093
KAFKA3_PORT=9094
KAFKA_UI_PORT=8080

# For Python apps running on HOST:
KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9093,localhost:9094

# For apps running inside Docker network:
KAFKA_BOOTSTRAP_SERVERS_DOCKER=kafka1:29092,kafka2:29092,kafka3:29092

# ============================================================
# MINIO
# ============================================================
MINIO_ROOT_USER=bankadmin
MINIO_ROOT_PASSWORD=BankMinio2026
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MINIO_ENDPOINT_HOST=http://localhost:9000
MINIO_ENDPOINT_DOCKER=http://minio:9000

# Suggested buckets (create from app/init job when needed)
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold
MINIO_BUCKET_ML=ml

# ============================================================
# AIRFLOW METADATA POSTGRESQL
# ============================================================
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=d4bank

# ============================================================
# AIRFLOW
# ============================================================
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=d4bank
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_PORT=8081
AIRFLOW_UID=1000
AIRFLOW_UID=1000
