FROM apache/spark:3.5.5

USER root
COPY docker/requirements-spark.txt /tmp/requirements-spark.txt
RUN python3 -m pip install --timeout 300 --retries 10 -r /tmp/requirements-spark.txt
RUN python3 -c "import urllib.request; files={'postgresql-42.7.13.jar':'https://jdbc.postgresql.org/download/postgresql-42.7.13.jar','hadoop-aws-3.3.4.jar':'https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-aws/3.3.4/hadoop-aws-3.3.4.jar','aws-java-sdk-bundle-1.12.262.jar':'https://repo1.maven.org/maven2/com/amazonaws/aws-java-sdk-bundle/1.12.262/aws-java-sdk-bundle-1.12.262.jar'}; [urllib.request.urlretrieve(url, '/opt/spark/jars/'+name) for name,url in files.items()]"
ENV PYTHONPATH=/workspace
WORKDIR /workspace
USER spark
