FROM apache/spark:3.5.5-scala2.12-java17-python3-ubuntu
USER root
COPY docker/requirements-spark.txt /tmp/requirements.txt
RUN pip3 install --no-cache-dir -r /tmp/requirements.txt
RUN curl --retry 5 --retry-all-errors -fsSL -o /opt/spark/jars/postgresql-42.7.5.jar \
    https://repo1.maven.org/maven2/org/postgresql/postgresql/42.7.5/postgresql-42.7.5.jar
RUN curl --retry 5 --retry-all-errors -fsSL -o /opt/spark/jars/hadoop-aws-3.3.4.jar \
    https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-aws/3.3.4/hadoop-aws-3.3.4.jar
RUN curl --retry 5 --retry-all-errors -fsSL -o /opt/spark/jars/aws-java-sdk-bundle-1.12.262.jar \
    https://repo1.maven.org/maven2/com/amazonaws/aws-java-sdk-bundle/1.12.262/aws-java-sdk-bundle-1.12.262.jar
WORKDIR /workspace
ENV PYTHONPATH=/workspace
