FROM apache/spark:3.5.5 AS spark_runtime
FROM apache/airflow:2.10.5
USER root
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jre-headless && rm -rf /var/lib/apt/lists/*
COPY --from=spark_runtime /opt/spark /opt/spark
COPY docker/requirements-spark.txt /tmp/requirements-spark.txt
USER airflow
RUN python -m pip install --timeout 300 --retries 10 -r /tmp/requirements-spark.txt
ENV SPARK_HOME=/opt/spark PATH=/opt/spark/bin:/opt/spark/sbin:${PATH} PYTHONPATH=/workspace
